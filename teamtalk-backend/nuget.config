<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Offline-friendly NuGet configuration for the backend.
    - Forces the global packages folder to the real user profile (outside the sandbox) to avoid access-denied errors.
    - Uses the existing local package cache as the only feed so restores succeed without internet.
  -->
  <config>
    <add key="globalPackagesFolder" value="C:\Users\pc780\.nuget\packages" />
    <add key="restoreDisableParallel" value="true" />
  </config>
  <packageSources>
    <clear />
    <add key="local-cache" value="C:\Users\pc780\.nuget\packages" />
    <add key="vs-offline" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\" />
  </packageSources>
  <disabledPackageSources>
    <add key="nuget.org" value="true" />
  </disabledPackageSources>
</configuration>
